# 通义千问API Key（必须，同时用于LLM和Embedding）
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Tavily搜索API Key（必须，用于网络检索）
TAVILY_API_KEY=your_tavily_api_key_here

# LLM配置
LLM_MODEL=qwen-turbo
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1000

# Embedding配置
EMBEDDING_MODEL=text-embedding-v2
EMBEDDING_DIM=1536

# ChromaDB配置
CHROMA_PERSIST_DIR=./data/vectordb/chroma
CHROMA_COLLECTION_NAME=engineering_qa

# BM25索引存储路径
BM25_INDEX_PATH=./data/vectordb/bm25_index.pkl

# 切片配置
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5

# 混合检索权重
VECTOR_WEIGHT=0.6
BM25_WEIGHT=0.4
LOCAL_WEIGHT=0.7
WEB_WEIGHT=0.3
LOCAL_THRESHOLD=0.5

# RAG配置
MAX_CONTEXT_LENGTH=6000

# API Configuration
API_HOST=0.0.0.0
API_PORT=5002
DEBUG=false

# CORS配置（生产环境应设置为具体域名，多个域名用逗号分隔）
# 示例: CORS_ORIGINS=["https://example.com","https://app.example.com"]
CORS_ORIGINS=["*"]
